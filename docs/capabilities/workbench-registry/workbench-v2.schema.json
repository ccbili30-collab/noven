{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creatx.local/schemas/workbench-v2.schema.json",
  "title": "CreatX Workbench V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "folder", "home"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "pattern": "^wb_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "folder": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "home": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "mode"],
      "properties": {
        "entry": { "type": "string", "minLength": 1 },
        "mode": { "const": "interactive" }
      }
    }
  }
}
