  "contentCards": [
    {
      "beat": "交代制定背景和制定者",
      "text": "赤历二十七年，摄政王阿德里安召集十二座驿城代表，议定一部统一道路与关卡的法典。",
      "claimIds": [
        "established-1"
      ]
    },
    {
      "beat": "呈现争议、施行与修订",
      "text": "初版令持王印者免桥税，却要求村庄无偿供马，遂有三郡抗税。七港商团赞同统一秤量，北境边侯则反对商人武装越领。",
      "claimIds": [
        "established-2",
        "established-4"
      ]
    },
    {
      "beat": "呈现争议、施行与修订",
      "text": "赤历三十一年修订，驿马改由道路银库按里程偿付，取代原有征调。",
      "claimIds": [
        "established-3"
      ]
    },
    {
      "beat": "说明长期影响和不同解释",
      "text": "四个王国至今援引法典保护朝圣者。洛恩法官称军队征用仅限王道境内；北境战时抄本则允许越界征用。",
      "claimIds": [
        "established-5",
        "contested-1",
        "contested-2"
      ]
    }
