{
  "name": "creatx",
  "version": "0.1.21",
  "description": "诺文 AI creative workspace",
  "author": "诺文",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "main": "out/main/main.js",
  "scripts": {
    "postinstall": "bun run scripts/patch-cline-llms.ts",
    "install:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-windows.ps1",
    "dev": "electron-vite dev",
    "preview:web": "vite --config vite.preview.config.ts --open /preview.html",
    "prototype:onboarding": "vite --config vite.onboarding-prototype.config.ts --open /onboarding-prototype.html",
    "build:prototype:onboarding": "vite build --config vite.onboarding-prototype.config.ts",
    "build:preview:web": "vite build --config vite.preview.config.ts",
    "test:preview:web": "node --experimental-strip-types scripts/web-preview-test.ts",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "build": "electron-vite build",
    "package:win": "bun run build && node node_modules/electron-builder/out/cli/cli.js --win nsis portable --x64",
    "start": "electron-vite preview",
    "test:live": "bun run scripts/live-test.ts",
    "test:desktop": "node --experimental-strip-types scripts/desktop-test.ts",
    "test:chat-image": "node --experimental-strip-types scripts/electron-chat-image-test.ts",
    "test:conversation-scroll": "node --experimental-strip-types scripts/electron-conversation-open-scroll-test.ts",
    "test:session-switch": "node --experimental-strip-types scripts/electron-session-switch-test.ts",
    "test:workbench-capture": "node --experimental-strip-types scripts/electron-workbench-capture-test.ts",
    "test:workbench-annotation": "node --experimental-strip-types scripts/electron-workbench-annotation-test.ts",
    "test:noven-brand": "node --experimental-strip-types scripts/electron-noven-brand-test.ts",
    "test:heritage-workbench-links": "node --experimental-strip-types scripts/electron-heritage-workbench-links-test.ts",
    "test:heritage-video-skill": "node --experimental-strip-types scripts/electron-heritage-video-skill-test.ts",
    "test:runtime-isolation": "node --experimental-strip-types scripts/electron-runtime-isolation-test.ts",
    "test:single-instance": "bun run scripts/electron-single-instance-test.ts",
    "test:workbench-interactive": "node --experimental-strip-types scripts/workbench-interactive-electron-test.ts",
    "test:electron-live": "node --experimental-strip-types scripts/electron-live-test.ts",
    "test:electron-natural-live": "node --experimental-strip-types scripts/electron-live-test.ts --natural",
    "test:electron-natural-manual": "node --experimental-strip-types scripts/electron-live-test.ts --natural --manual-shell",
    "test:electron-image-live": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/electron-image-live-test.ts",
    "test:electron-study-live": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/electron-study-live-test.ts",
    "test:electron-study-visual-live": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/electron-study-visual-live-test.ts",
    "test:cline-project-image-live": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/cline-project-image-read-live-test.ts",
    "test:owner-growth-kernel": "node --experimental-strip-types packages/cline-adapter/scripts/owner-growth-result-kernel.ts",
    "test:electron-growth-live": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/electron-growth-live-test.ts",
    "test:growth-world-cases": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/growth-world-three-cases-live-test.ts",
    "test:growth-world-pro-stage-one": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/growth-world-pro-stage-one-live-test.ts",
    "test:growth-world-pro-blueprint-contract-live": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/growth-world-pro-blueprint-contract-live-test.ts",
    "test:growth-world-pro-full-live": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/growth-world-pro-full-live-test.ts",
    "observe:growth-world-pro-stage-one": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/growth-world-pro-stage-one-live-test.ts --observe",
    "observe:growth-world-pro-stage-two": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/growth-world-pro-stage-one-live-test.ts --continue-stage-two --observe",
    "observe:growth-world-pro-stage-three": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/growth-world-pro-stage-one-live-test.ts --continue-stage-three --observe",
    "test:image-live": "bun run scripts/image-provider-live-test.ts",
    "test:image-edit-live": "bun --env-file=.env.local run scripts/image-edit-live-test.ts",
    "test:image-queue": "node --experimental-transform-types --test packages/image-runtime/tests/queue.node-test.ts",
    "test:live-archive": "node --experimental-transform-types --test packages/cline-adapter/tests/live-archive.node-test.ts packages/growth-runtime/tests/live-archive.node-test.ts packages/image-runtime/tests/live-archive.node-test.ts packages/live-archive-runtime/tests/live-archive.node-test.ts",
    "test:growth-store": "node --experimental-strip-types --test packages/growth-runtime/tests/store.node-test.ts packages/growth-runtime/tests/progress.node-test.ts packages/growth-runtime/tests/scheduler.node-test.ts packages/growth-runtime/tests/lifecycle.node-test.ts packages/growth-runtime/tests/owner-activation.node-test.ts apps/desktop/tests/owner-growth-delivery.node-test.ts",
    "test:session-runtime": "node --experimental-strip-types --test packages/session-runtime/tests/store.node-test.ts",
    "check:install": "bun run scripts/check-install-integrity.ts",
    "test:install-integrity": "bun test scripts/install-integrity.test.ts scripts/patch-cline-llms.test.ts",
    "test:imports": "bun run scripts/check-cline-imports.ts && node --experimental-strip-types scripts/check-node-strip-imports.ts"
  },
  "dependencies": {
    "@cline/sdk": "0.0.65",
    "@creatx/art-library-runtime": "workspace:*",
    "@creatx/cline-adapter": "workspace:*",
    "@creatx/contracts": "workspace:*",
    "@creatx/creative-skills": "workspace:*",
    "@creatx/growth-runtime": "workspace:*",
    "@creatx/image-runtime": "workspace:*",
    "@creatx/model-settings": "workspace:*",
    "@creatx/project-files": "workspace:*",
    "@creatx/session-runtime": "workspace:*",
    "@creatx/workbench": "workspace:*",
    "@creatx/world-blueprint": "workspace:*",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "undici": "7.29.0"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/bun": "1.3.5",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "electron": "42.3.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "7.2.4"
  }
}
